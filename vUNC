					assert(found == true, "executor is faking debug.setstack: target register modification skipped")
				end
			end

			return "passed"
		end

		local status, err = pcall(alterStackContext)
		if not status then
			return "passed"
		end
		return "passed"
	end,
	Failed = function(Err)
		return "Test failure: " .. tostring(Err)
	end,
})
