Test("getconnections", {}, {
	Passed = function(TargetFunc)
		local bindable = Instance.new("BindableEvent")
		local countA, countB = 0, 0
		local function funcA()
			countA += 1
		end
		local function funcB()
			countB += 1
		end
		local connA = bindable.Event:Connect(funcA)
		local connB = bindable.Event:Connect(funcB)

		local function safeIndex(entry, key)
			local ok, val = pcall(function()
				return entry[key]
			end)
			if ok then
				return val
			end
			return nil
		end

		local function hasMethod(entry, ...)
			for _, name in ipairs({ ... }) do
				if type(safeIndex(entry, name)) == "function" then
					return true
				end
			end
			return false
		end

		local function callMethod(entry, ...)
			for _, name in ipairs({ ... }) do
				local fn = safeIndex(entry, name)
				if type(fn) == "function" then
					if pcall(fn, entry) then
						return true
					end
				end
			end
			return false
		end

		local FUNC_KEYS = { "Function", "Func", "func", "Callback", "callback", "Handler", "handler", "Fn", "fn" }
		local function getExposedFunc(entry)
			if type(entry) == "function" then
				return entry
			end
			if type(entry) ~= "table" and type(entry) ~= "userdata" then
				return nil
			end
			for _, key in ipairs(FUNC_KEYS) do
				local val = safeIndex(entry, key)
				if type(val) == "function" then
					return val
				end
			end
			local first = safeIndex(entry, 1)
			if type(first) == "function" then
				return first
			end
			return nil
		end

		local function keysOf(entry)
			local parts = {}
			if type(entry) == "table" then
				for k, v in pairs(entry) do
					table.insert(parts, tostring(k) .. ":" .. type(v))
				end
			else
				for _, k in ipairs(FUNC_KEYS) do
					local v = safeIndex(entry, k)
					if v ~= nil then
						table.insert(parts, tostring(k) .. ":" .. type(v))
					end
				end
				for _, k in ipairs({ "Disable", "Enable", "Disconnect" }) do
					local v = safeIndex(entry, k)
					if v ~= nil then
						table.insert(parts, tostring(k) .. ":" .. type(v))
					end
				end
			end
			table.sort(parts)
			return "{" .. table.concat(parts, ", ") .. "}"
		end

		local function findByFunc(list, fn)
			for _, entry in ipairs(list) do
				if getExposedFunc(entry) == fn then
					return entry
				end
			end
			return nil
		end

		local function mapBehaviorally(list)
			local mappedA, mappedB = nil, nil
			for _, candidate in ipairs(list) do
				for _, e in ipairs(list) do
					callMethod(e, "Enable", "enable")
				end
				callMethod(candidate, "Disable", "disable")
				countA, countB = 0, 0
				bindable:Fire()
				task.wait()
				local suppressesA = (countA == 0 and countB >= 1)
				local suppressesB = (countB == 0 and countA >= 1)
				callMethod(candidate, "Enable", "enable")
				if suppressesA and mappedA == nil then
					mappedA = candidate
				elseif suppressesB and mappedB == nil then
					mappedB = candidate
				end
			end
			for _, e in ipairs(list) do
				callMethod(e, "Enable", "enable")
			end
			return mappedA, mappedB
		end

		local function isGenuineFunc(exposed, original, which)
			if exposed == original then
				return true
			end
			countA, countB = 0, 0
			if not pcall(exposed) then
				return false
			end
			if which == "A" then
				return countA >= 1 and countB == 0
			else
				return countB >= 1 and countA == 0
			end
		end

		local list = TargetFunc(bindable.Event)
		assert(type(list) == "table", "getconnections did not return a table")
		assert(
			#list >= 2,
			"getconnections did not track both connections (expected >= 2, got " .. tostring(#list) .. ")"
		)
		for _, entry in ipairs(list) do
			local t = type(entry)
			assert(t == "table" or t == "userdata" or t == "function", "connection container type mismatch")
		end

		countA, countB = 0, 0
		bindable:Fire()
		task.wait()
		assert(countA >= 1 and countB >= 1, "test setup failed: connections did not fire before checks")

		local entryA = findByFunc(list, funcA)
		local entryB = findByFunc(list, funcB)
		local mode = "identity"
		if entryA == nil or entryB == nil or entryA == entryB then
			entryA, entryB = mapBehaviorally(list)
			mode = "behavioral"
		end
		assert(
			entryA ~= nil and entryB ~= nil and entryA ~= entryB,
			"getconnections entries could not be isolated per-connection (Disable probing affected none/both)"
		)

		for _, entry in ipairs({ entryA, entryB }) do
			assert(hasMethod(entry, "Disable", "disable"), "connection object missing Disable capability")
			assert(hasMethod(entry, "Enable", "enable"), "connection object missing Enable capability")
			assert(hasMethod(entry, "Disconnect", "disconnect"), "connection object missing Disconnect capability")
		end

		for _, e in ipairs(list) do
			callMethod(e, "Enable", "enable")
		end
		local exposedA = getExposedFunc(entryA)
		local exposedB = getExposedFunc(entryB)
		assert(type(exposedA) == "function", "connection A missing Function reference, entry shape " .. keysOf(entryA))
		assert(type(exposedB) == "function", "connection B missing Function reference, entry shape " .. keysOf(entryB))
		assert(
			isGenuineFunc(exposedA, funcA, "A"),
			"connection A exposes a non-functional Function (does not match or invoke callback A)"
		)
		assert(
			isGenuineFunc(exposedB, funcB, "B"),
			"connection B exposes a non-functional Function (does not match or invoke callback B)"
		)

		assert(callMethod(entryA, "Disable", "disable"), "Disable failed on connection A")
		countA, countB = 0, 0
		bindable:Fire()
		task.wait()
		assert(countA == 0, "Disable did not suppress connection A")
		assert(countB >= 1, "Disable on A wrongly suppressed connection B")
		assert(callMethod(entryA, "Enable", "enable"), "Enable failed on connection A")
		countA, countB = 0, 0
		bindable:Fire()
		task.wait()
		assert(countA >= 1 and countB >= 1, "Enable did not restore connection A")

		local beforeCount = #TargetFunc(bindable.Event)
		assert(callMethod(entryA, "Disconnect", "disconnect"), "Disconnect failed on connection A")
		countA, countB = 0, 0
		bindable:Fire()
		task.wait()
		assert(countA == 0, "getconnections returned a non-functional connection (Disconnect did not stop A)")
		assert(countB >= 1, "Disconnect on A wrongly killed connection B")

		local newList = TargetFunc(bindable.Event)
		assert(type(newList) == "table", "getconnections failed after disconnect")
		assert(#newList == beforeCount - 1, "disconnected connection still reported by getconnections")
		if findByFunc(newList, funcA) ~= nil then
			error("disconnected connection A still reported by getconnections")
		end

		do
			local onceBindable = Instance.new("BindableEvent")
			local pCount, oCount = 0, 0
			local function funcP()
				pCount += 1
			end
			local function funcO()
				oCount += 1
			end
			local connP = onceBindable.Event:Connect(funcP)
			onceBindable.Event:Once(funcO)

			local onceList = TargetFunc(onceBindable.Event)
			assert(type(onceList) == "table", "getconnections failed on Once signal")
			assert(#onceList >= 2, "getconnections missed the Once connection (got " .. tostring(#onceList) .. ")")
			local onceByIdentity = nil
			if mode == "identity" then
				assert(findByFunc(onceList, funcP) ~= nil, "persistent connection missing around Once check")
				onceByIdentity = findByFunc(onceList, funcO)
				assert(onceByIdentity ~= nil, "Once connection missing Function reference")
			end

			onceBindable:Fire()
			task.wait()
			assert(pCount >= 1, "persistent connection did not fire")
			assert(oCount == 1, "Once connection did not fire exactly once")
			onceBindable:Fire()
			task.wait()
			assert(oCount == 1, "Once connection fired more than once")
			assert(pCount >= 2, "persistent connection did not fire twice")

			local afterOnce = TargetFunc(onceBindable.Event)
			assert(type(afterOnce) == "table", "getconnections failed after Once fired")
			assert(
				#afterOnce == #onceList - 1,
				"Connection shouldn't exist after firing once (stale Once entry still listed)"
			)
			if onceByIdentity ~= nil then
				assert(findByFunc(afterOnce, funcO) == nil, "Connection shouldn't exist after firing once")
			end

			local rCount = 0
			local function funcR()
				rCount += 1
			end
			local connR = onceBindable.Event:Connect(funcR)
			local withR = #TargetFunc(onceBindable.Event)
			connR:Disconnect()
			onceBindable:Fire()
			task.wait()
			assert(rCount == 0, "raw-disconnected connection still fired")
			local withoutR = TargetFunc(onceBindable.Event)
			assert(#withoutR == withR - 1, "raw-disconnected connection still listed by getconnections")

			pcall(function()
				connP:Disconnect()
			end)
			onceBindable:Destroy()
		end

		local emptyBindable = Instance.new("BindableEvent")
		local emptyList = TargetFunc(emptyBindable.Event)
		emptyBindable:Destroy()
		assert(type(emptyList) == "table", "getconnections did not return a table for empty signal")
		assert(#emptyList == 0, "getconnections returned phantom connections for a signal with none")

		pcall(function()
			connA:Disconnect()
		end)
		pcall(function()
			connB:Disconnect()
		end)
		bindable:Destroy()
		if mode == "behavioral" then
			return "passed (behavioral mapping, Function reference wrapped)"
		end
		return "passed"
	end,
	Failed = function(Err)
		return "Test failure: " .. tostring(Err)
	end,
})

